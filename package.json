{
  "name": "react-f0rm",
  "version": "0.2.0",
  "packageManager": "pnpm@11.4.0",
  "description": "react form",
  "main": "dist/index.cjs.js",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs.js"
    },
    "./resolvers/standard-schema": {
      "types": "./dist/resolvers/standard-schema.d.ts",
      "import": "./dist/resolvers/standard-schema.mjs",
      "require": "./dist/resolvers/standard-schema.cjs.js"
    },
    "./resolvers/zod": {
      "types": "./dist/resolvers/zod.d.ts",
      "import": "./dist/resolvers/zod.mjs",
      "require": "./dist/resolvers/zod.cjs.js"
    },
    "./resolvers/yup": {
      "types": "./dist/resolvers/yup.d.ts",
      "import": "./dist/resolvers/yup.mjs",
      "require": "./dist/resolvers/yup.cjs.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.mjs",
      "require": "./dist/devtools/index.cjs.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "start": "vitest --watch",
    "commit": "lint-staged && git-cz -n",
    "build": "npm run clean && cross-env NODE_ENV=production rollup -c",
    "prepublishOnly": "rimraf dist && npm run build",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist node_modules/.cache",
    "lint:fix": "eslint --fix src/ test/",
    "lint": "eslint src/ test/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "size": "size-limit",
    "docs:build": "cd docs-site && npm run build",
    "docs:deploy": "cd docs-site && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmzy/react-f0rm.git"
  },
  "keywords": [
    "react",
    "form",
    "react-form"
  ],
  "author": "wmzy <1256573276@qq.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wmzy/react-f0rm/issues"
  },
  "homepage": "https://github.com/wmzy/react-f0rm#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "valibot": ">=1.0.0",
    "yup": ">=0.32.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    },
    "yup": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "babel-loader": "^10.1.1",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-builtin-compat": "0.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "size-limit": "^13.0.3",
    "storybook": "^10.5.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@for-fun/event-emitter": "^1.0.1",
    "use-sync-external-store": "^1.6.0"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "10 KB"
    }
  ]
}
