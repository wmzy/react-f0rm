{
  "name": "react-f0rm",
  "version": "0.1.0",
  "packageManager": "pnpm@11.4.0",
  "description": "react form",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    },
    "./resolvers/standard-schema": {
      "types": "./dist/resolvers/standard-schema.d.ts",
      "import": "./dist/resolvers/standard-schema.esm.js",
      "require": "./dist/resolvers/standard-schema.cjs.js"
    },
    "./resolvers/zod": {
      "types": "./dist/resolvers/zod.d.ts",
      "import": "./dist/resolvers/zod.esm.js",
      "require": "./dist/resolvers/zod.cjs.js"
    },
    "./resolvers/yup": {
      "types": "./dist/resolvers/yup.d.ts",
      "import": "./dist/resolvers/yup.esm.js",
      "require": "./dist/resolvers/yup.cjs.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.esm.js",
      "require": "./dist/devtools/index.cjs.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "start": "vitest --watch",
    "commit": "lint-staged && git-cz -n",
    "build": "npm run clean && cross-env NODE_ENV=production rollup -c",
    "prepublishOnly": "rimraf dist && npm run build",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist node_modules/.cache",
    "lint:fix": "eslint --fix src/ test/",
    "lint": "eslint src/ test/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "size": "size-limit",
    "docs:build": "cd docs-site && npm run build",
    "docs:deploy": "cd docs-site && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmzy/react-f0rm.git"
  },
  "keywords": [
    "react",
    "form",
    "react-form"
  ],
  "author": "wmzy <1256573276@qq.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wmzy/react-f0rm/issues"
  },
  "homepage": "https://github.com/wmzy/react-f0rm#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "valibot": ">=1.0.0",
    "yup": ">=0.32.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    },
    "yup": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.22.8",
    "@babel/eslint-parser": "^7.22.7",
    "@babel/preset-env": "^7.22.7",
    "@babel/preset-react": "^7.22.5",
    "@babel/register": "^7.22.5",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^25.0.2",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-replace": "^5.0.2",
    "@rollup/plugin-terser": "^0.4.3",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-links": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.14",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "babel-loader": "^9.1.3",
    "commitizen": "^4.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.44.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-builtin-compat": "0.0.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^10.4.1",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^8.0.3",
    "jsdom": "^24.0.0",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.85.0",
    "rimraf": "^5.0.1",
    "rollup": "^3.26.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "size-limit": "^12.1.0",
    "storybook": "^10.4.1",
    "typescript": "^5.1.6",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@for-fun/event-emitter": "^1.0.0",
    "use-sync-external-store": "^1.6.0"
  },
  "size-limit": [
    {
      "path": "dist/index.esm.js",
      "limit": "10 KB"
    }
  ]
}
