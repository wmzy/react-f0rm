{
  "name": "react-f0rm",
  "version": "0.0.0-development",
  "packageManager": "pnpm@11.4.0",
  "description": "react form",
  "main": "dist/index.cjs.js",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.umd.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs.js"
      }
    },
    "./resolvers/standard-schema": {
      "import": {
        "types": "./dist/resolvers/standard-schema.d.mts",
        "default": "./dist/resolvers/standard-schema.mjs"
      },
      "require": {
        "types": "./dist/resolvers/standard-schema.d.cts",
        "default": "./dist/resolvers/standard-schema.cjs.js"
      }
    },
    "./resolvers/zod": {
      "import": {
        "types": "./dist/resolvers/zod.d.mts",
        "default": "./dist/resolvers/zod.mjs"
      },
      "require": {
        "types": "./dist/resolvers/zod.d.cts",
        "default": "./dist/resolvers/zod.cjs.js"
      }
    },
    "./resolvers/yup": {
      "import": {
        "types": "./dist/resolvers/yup.d.mts",
        "default": "./dist/resolvers/yup.mjs"
      },
      "require": {
        "types": "./dist/resolvers/yup.d.cts",
        "default": "./dist/resolvers/yup.cjs.js"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools/index.d.mts",
        "default": "./dist/devtools/index.mjs"
      },
      "require": {
        "types": "./dist/devtools/index.d.cts",
        "default": "./dist/devtools/index.cjs.js"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.mts",
        "default": "./dist/server/index.mjs"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs.js"
      }
    },
    "./persist": {
      "import": {
        "types": "./dist/persist.d.mts",
        "default": "./dist/persist.mjs"
      },
      "require": {
        "types": "./dist/persist.d.cts",
        "default": "./dist/persist.cjs.js"
      }
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "server.js",
    "server.d.ts",
    "devtools.js",
    "devtools.d.ts",
    "persist.js",
    "persist.d.ts",
    "resolvers"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "start": "vitest --watch",
    "commit": "lint-staged && git-cz -n",
    "build": "npm run clean && cross-env NODE_ENV=production rollup -c && node scripts/postbuild.mjs",
    "prepublishOnly": "rimraf dist && npm run build",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist node_modules/.cache",
    "lint:fix": "eslint --fix src/ test/",
    "lint": "eslint src/ test/",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "size": "size-limit",
    "bench:report": "vitest bench --run --reporter=json --outputFile=bench-results.json test/bench/ && node scripts/bench-report.mjs",
    "docs:build": "cd docs-site && npm run build",
    "docs:deploy": "cd docs-site && npm run deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmzy/react-f0rm.git"
  },
  "keywords": [
    "react",
    "form",
    "react-form",
    "react-hook-form",
    "tanstack-form",
    "controlled-form",
    "form-validation",
    "typescript",
    "standard-schema",
    "form-library"
  ],
  "author": "wmzy <1256573276@qq.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wmzy/react-f0rm/issues"
  },
  "homepage": "https://github.com/wmzy/react-f0rm#readme",
  "peerDependencies": {
    "react": ">=18.0.0",
    "valibot": ">=1.0.0",
    "yup": ">=0.32.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    },
    "yup": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^7.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tanstack/react-form": "^1.33.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "antd": "^5.29.3",
    "babel-loader": "^10.1.1",
    "commitizen": "^4.3.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-builtin-compat": "0.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "size-limit": "^13.0.3",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "12.5 KB",
      "ignore": [
        "@for-fun/event-emitter"
      ]
    },
    {
      "path": "dist/index.mjs",
      "limit": "14 KB",
      "gzip": true,
      "ignore": [
        "@for-fun/event-emitter"
      ]
    },
    {
      "path": "dist/devtools/index.mjs",
      "limit": "9 KB",
      "gzip": true
    },
    {
      "path": "dist/resolvers/standard-schema.mjs",
      "limit": "1.5 KB",
      "gzip": true
    },
    {
      "path": "dist/resolvers/zod.mjs",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "path": "dist/resolvers/yup.mjs",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "path": "dist/server/index.mjs",
      "limit": "5 KB",
      "gzip": true
    },
    {
      "path": "dist/persist.mjs",
      "limit": "3 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@for-fun/event-emitter": "^1.1.0"
  }
}
