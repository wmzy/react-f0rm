{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "jsx": "react",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "coverage"]
}
